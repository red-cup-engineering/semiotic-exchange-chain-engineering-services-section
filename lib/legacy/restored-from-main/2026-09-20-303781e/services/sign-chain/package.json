{
  "name": "@red-cup-engineering/sign-chain",
  "version": "0.2.0",
  "type": "module",
  "description": "Pure append and deterministic replay contract for witnessed semiotic claims.",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.mts",
    "prepack": "npm run check && npm run build && npm run test"
  },
  "dependencies": {
    "@red-cup-engineering/computer-data-engine": "0.9.0",
    "@red-cup-engineering/sign-cell": "0.1.0",
    "@red-cup-engineering/sign-craft": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "license": "LicenseRef-561Group-1.0",
  "sideEffects": false
}
